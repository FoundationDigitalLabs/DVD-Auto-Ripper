# =============================================================================
#  DVD Auto-Ripper Configuration
# =============================================================================
#  Copy this file to 'config.env' and edit the values below.
#
#    cp config.env.example config.env
#
# =============================================================================

# --- PATH CONFIGURATION ---
# Root directory where all rip data is stored
DRIVE_ROOT="$HOME/Desktop/DVD-Rips"

# Final destination for completed .mkv files
DEST_FOLDER="$DRIVE_ROOT/MakeMKV"

# Temporary working directory.
# Cleaned up after successful rips; retained when partial files need inspection.
BASE_TEMP="$DRIVE_ROOT/temp_rip_work"

# --- RIP SETTINGS ---
# Minimum title length in seconds. Titles shorter than this are skipped.
# This filters out menus, trailers, and bonus features.
# Examples: 900 = 15 min, 1800 = 30 min, 3600 = 60 min
MIN_LENGTH=900

# Minimum free disk space in GB required before starting a rip.
# The script will skip the disc and eject if space is below this.
# Recommended: 10 for DVDs, 60 for Blu-rays, 110 for 4K UHD
MIN_SPACE_GB=10

# Safety check for DRIVE_ROOT paths under /media or /mnt.
# Keep this at 0 for external drives so the script fails if the drive is not mounted.
# Set to 1 only if DRIVE_ROOT is intentionally a normal local directory.
ALLOW_UNMOUNTED_DRIVE_ROOT=0
